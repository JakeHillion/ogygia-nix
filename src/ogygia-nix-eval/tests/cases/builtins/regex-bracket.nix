[
  (builtins.match "[[:alpha:]]+" "abc")
  (builtins.match "[[:ALPHA:]]" "a")
  (builtins.match "[[:d:]]" "5")
  (builtins.match "[[:w:]]" "_")
  (builtins.match "[[:s:]]" " ")
  (builtins.match "[[:alpha:][:digit:]]+" "a1")
  (builtins.match "[[:alpha:]-]" "-")
  (builtins.match "[[.a.]]" "a")
  (builtins.match "[[.period.]]" ".")
  (builtins.match "[[.hyphen.]]" "-")
  (builtins.match "[[.a.]-c]" "b")
  (builtins.match "[[=a=]]" "A")
  (builtins.match "[[=A=]]" "a")
  (builtins.match "[^[=a=]]" "A")
  (builtins.match "[[=period=]]" ".")
  (builtins.match "[a-]" "-")
  (builtins.match "[%--]" "+")
  (builtins.match "[--z]" "a")
  (builtins.match "[]-a]" "^")
  (builtins.match "[[]" "[")
  (builtins.match "[a[]" "[")
  (builtins.match "[a&&b]" "&")
  (builtins.match "[~~]" "~")
  (builtins.match "[\\]" "\\")
]
