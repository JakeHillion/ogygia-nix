[
  (builtins.match "( ?)+" " ")
  (builtins.match "(a?)*" "")
  (builtins.match "(a?)*" "aa")
  (builtins.match "(a?){1,}" "a")
  (builtins.match "(a?){1,3}" "aaa")
  (builtins.match "(b?|a)+" "a")
  (builtins.match "(b?|a)*" "a")
  (builtins.match "((b?)|(a))+" "aa")
  (builtins.match "((^)|a)*" "a")
  (builtins.match "(a|(^))*" "a")
  (builtins.match "((a?)*)*" "a")
  (builtins.match "((a?)+(b?))*" "abab")
  (builtins.match "((a)?)*" "aa")
  (builtins.match "(a*)*b" "aab")
  (builtins.split "([[:space:]]?)+" " a  b ")
  (builtins.split "(a|)+" " a")
  (builtins.split "((a)|($))*" "ab")
]
