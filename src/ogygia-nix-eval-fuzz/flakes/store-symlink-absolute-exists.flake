#~flake path:@dir(root)#x
#~tree dep store
#~file sub/f
1
#~file abs link
@dir(dep)/sub
#~tree root path
#~file flake.nix
{
  inputs.dep = { url = "github:o/dep"; flake = false; };
  outputs = { self, dep }: { x = builtins.pathExists (dep + "/abs/f"); };
}
#~file flake.lock
{
  "nodes": {
    "dep": {
      "flake": false,
      "locked": { "lastModified": 1700000000, "narHash": "@narHash(dep)", "owner": "o", "repo": "dep", "rev": "0123456789abcdef0123456789abcdef01234567", "type": "github" },
      "original": { "owner": "o", "repo": "dep", "type": "github" }
    },
    "root": { "inputs": { "dep": "dep" } }
  },
  "root": "root",
  "version": 7
}
