#~flake path:@dir(root)#x
#~tree st store
#~file a
x
#~file l link
a
#~tree root path
#~file flake.nix
{
  outputs = { self }: {
    x =
      let
        p = builtins.path { path = /nonexistent; name = "source"; sha256 = "@narHash(st)"; };
      in
      {
        inherit p;
        read = builtins.readFile (p + "/l");
        type = builtins.readFileType (p + "/l");
        dir = builtins.readDir p;
        exists = builtins.pathExists (p + "/b");
        hash = builtins.hashFile "sha256" (p + "/a");
        plain = builtins.seq p (builtins.readFile "/nix/store/w0byc5x4bp4268xnaiwbr302nc95mip5-source/a");
      };
  };
}
