#~flake path:@dir(root)#x
#~tree root path
#~file flake.nix
{
  outputs = { self }: {
    x = {
      absolute = builtins.pathExists (self + "/absolute/default.nix");
      reenter = builtins.pathExists (self + "/reenter/default.nix");
    };
  };
}
#~file sub/default.nix
1
#~file absolute link
@dir(root)/sub
#~file reenter link
../root/sub
